# ==============================================================================
# CONFIGURATION OFFICIELLE - PROJEKTA
# ==============================================================================

# 1. URL publique de production du site (sans slash final)
# Utilisée pour metadataBase, Open Graph, Twitter Cards, sitemap.xml, robots.txt et liens canoniques.
# Exemples : https://projekta.vercel.app ou https://projekta-tech.com
NEXT_PUBLIC_SITE_URL=https://projekta.vercel.app

# 2. Adresse email professionnelle de réception des messages et devis
# Utilisée par /api/contact et /api/devis pour l'acheminement des notifications.
CONTACT_EMAIL=keithsorail@gmail.com

# 3. Clé API pour l'envoi réel des emails (optionnel, ex: Resend)
# Si non renseignée, les messages sont validés, protégés anti-spam et consignés en logs serveur.
RESEND_API_KEY=
